---
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<section class="pks-hero" aria-labelledby="pks-hero-title">
  <div class="pks-hero-grid" aria-hidden="true"></div>
  <div class="pks-orbit pks-orbit-one" aria-hidden="true"></div>
  <div class="pks-orbit pks-orbit-two" aria-hidden="true"></div>

  <div class="pks-hero-copy">
    <p class="pks-eyebrow"><span></span> LOCAL KNOWLEDGE SYSTEM</p>
    <h1 id="pks-hero-title">让每段对话<br />沉淀为<span>可复用的知识。</span></h1>
    <p class="pks-hero-lede">个人本地 Wiki 会把 LLM 对话中的结论、方法与边界，整理成之后找得到、看得懂、用得上的知识资产。</p>
    <div class="pks-hero-actions">
      <a class="pks-button pks-button-primary" href={`${base}wiki/`}>浏览 Wiki <span aria-hidden="true">→</span></a>
      <code>/pks 录入当前会话</code>
    </div>
  </div>

  <div class="pks-console" aria-label="知识库录入示例">
    <div class="pks-console-bar"><span></span><span></span><span></span><b>knowledge.capture</b></div>
    <div class="pks-console-body">
      <p><i>$</i> /pks 录入当前会话</p>
      <p class="pks-console-muted">分析 · 总结 · 分类 · 写入 Wiki</p>
      <div class="pks-console-result">
        <span>✓</span>
        <div><b>知识已归档</b><small>技术 / 前端 / React</small></div>
      </div>
    </div>
  </div>

  <div class="pks-hero-foot">
    <span>对话不是终点</span><i></i><span>知识才是</span>
  </div>
</section>
