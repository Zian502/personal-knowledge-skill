---
import Search from 'virtual:starlight/components/Search';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<div class="pks-header">
  <a class="pks-brand" href={base} aria-label="个人知识库首页">
    <span class="pks-brand-mark" aria-hidden="true"><i></i><i></i><i></i></span>
    <span>个人知识库</span>
    <small>PKS</small>
  </a>

  <nav class="pks-nav" aria-label="主导航">
    <a href={base}>概览</a>
    <a href={`${base}wiki/`}>Wiki</a>
  </nav>

  <div class="pks-header-tools">
    <Search />
    <ThemeSelect />
  </div>
</div>
