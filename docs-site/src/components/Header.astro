---
import Search from 'virtual:starlight/components/Search';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<div class="pks-header">
  <a class="pks-brand" href={base} aria-label="个人知识库首页">
    <img class="pks-brand-logo" src={`${base}favicon.svg`} alt="" width="32" height="32" />
    <span>个人知识库</span>
  </a>

  <nav class="pks-nav" aria-label="主导航">
    <a href={base}>概览</a>
    <a href={`${base}wiki/`}>Wiki</a>
  </nav>

  <div class="pks-header-tools">
    <Search />
    <div class="pks-theme-preference">
      <button
        type="button"
        class="pks-theme-trigger"
        data-theme-value="auto"
        aria-haspopup="menu"
        aria-expanded="false"
        aria-controls="pks-theme-menu"
        aria-label="主题：自动"
      >
        <span class="pks-theme-icon" data-theme-icon="auto" aria-hidden="true">
          <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="13" rx="2"></rect><path d="M8 21h8M12 17v4"></path></svg>
        </span>
        <span class="pks-theme-icon" data-theme-icon="light" aria-hidden="true" hidden>
          <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41"></path></svg>
        </span>
        <span class="pks-theme-icon" data-theme-icon="dark" aria-hidden="true" hidden>
          <svg viewBox="0 0 24 24"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8Z"></path></svg>
        </span>
        <span data-theme-label>自动</span>
        <svg class="pks-theme-caret" viewBox="0 0 16 16" aria-hidden="true"><path d="m3.5 6 4.5 4.5L12.5 6"></path></svg>
      </button>

      <div class="pks-theme-menu" id="pks-theme-menu" role="menu" aria-label="主题">
        <button type="button" role="menuitemradio" aria-checked="true" data-theme-option="auto">
          <span class="pks-theme-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="13" rx="2"></rect><path d="M8 21h8M12 17v4"></path></svg>
          </span>
          <span>自动</span>
          <svg class="pks-theme-check" viewBox="0 0 16 16" aria-hidden="true"><path d="m3 8.5 3 3 7-7"></path></svg>
        </button>
        <button type="button" role="menuitemradio" aria-checked="false" data-theme-option="light">
          <span class="pks-theme-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41"></path></svg>
          </span>
          <span>浅色</span>
          <svg class="pks-theme-check" viewBox="0 0 16 16" aria-hidden="true"><path d="m3 8.5 3 3 7-7"></path></svg>
        </button>
        <button type="button" role="menuitemradio" aria-checked="false" data-theme-option="dark">
          <span class="pks-theme-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8Z"></path></svg>
          </span>
          <span>深色</span>
          <svg class="pks-theme-check" viewBox="0 0 16 16" aria-hidden="true"><path d="m3 8.5 3 3 7-7"></path></svg>
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  type Theme = 'auto' | 'light' | 'dark';
  const themeStorageKey = 'starlight-theme';
  const themeLabels: Record<Theme, string> = {
    auto: '自动',
    light: '浅色',
    dark: '深色',
  };
  const parseTheme = (value: unknown): Theme =>
    value === 'light' || value === 'dark' ? value : 'auto';
  const preferredTheme = (): Exclude<Theme, 'auto'> =>
    matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';

  for (const preference of document.querySelectorAll<HTMLElement>('.pks-theme-preference')) {
    const trigger = preference.querySelector<HTMLButtonElement>('.pks-theme-trigger');
    const menu = preference.querySelector<HTMLElement>('.pks-theme-menu');
    const options = Array.from(
      preference.querySelectorAll<HTMLButtonElement>('[data-theme-option]'),
    );
    if (!trigger || !menu) continue;

    const closeMenu = (restoreFocus = false) => {
      trigger.setAttribute('aria-expanded', 'false');
      if (restoreFocus) trigger.focus();
    };
    const applyTheme = (theme: Theme) => {
      document.documentElement.dataset.theme = theme === 'auto' ? preferredTheme() : theme;
      localStorage.setItem(themeStorageKey, theme === 'auto' ? '' : theme);
      trigger.dataset.themeValue = theme;
      trigger.querySelector<HTMLElement>('[data-theme-label]')!.textContent = themeLabels[theme];
      trigger.setAttribute('aria-label', `主题：${themeLabels[theme]}`);
      for (const icon of trigger.querySelectorAll<HTMLElement>('[data-theme-icon]')) {
        icon.hidden = icon.dataset.themeIcon !== theme;
      }
      for (const option of options) {
        option.setAttribute('aria-checked', String(option.dataset.themeOption === theme));
      }
    };

    applyTheme(parseTheme(localStorage.getItem(themeStorageKey)));
    trigger.addEventListener('click', () => {
      const willOpen = trigger.getAttribute('aria-expanded') !== 'true';
      trigger.setAttribute('aria-expanded', String(willOpen));
    });
    trigger.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp') return;
      event.preventDefault();
      trigger.setAttribute('aria-expanded', 'true');
      options[event.key === 'ArrowDown' ? 0 : options.length - 1]?.focus();
    });
    for (const option of options) {
      option.addEventListener('click', () => {
        applyTheme(parseTheme(option.dataset.themeOption));
        closeMenu(true);
      });
    }
    menu.addEventListener('keydown', (event) => {
      const activeIndex = options.indexOf(document.activeElement as HTMLButtonElement);
      if (event.key === 'Escape') {
        event.preventDefault();
        closeMenu(true);
        return;
      }
      if (!['ArrowDown', 'ArrowUp', 'Home', 'End'].includes(event.key)) return;
      event.preventDefault();
      const nextIndex =
        event.key === 'Home' ? 0
        : event.key === 'End' ? options.length - 1
        : event.key === 'ArrowDown' ? (activeIndex + 1) % options.length
        : (activeIndex - 1 + options.length) % options.length;
      options[nextIndex]?.focus();
    });
    document.addEventListener('click', (event) => {
      if (event.target instanceof Node && !preference.contains(event.target)) closeMenu();
    });
  }

  matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => {
    for (const trigger of document.querySelectorAll<HTMLButtonElement>('.pks-theme-trigger')) {
      if (trigger.dataset.themeValue === 'auto') {
        document.documentElement.dataset.theme = preferredTheme();
      }
    }
  });
</script>
